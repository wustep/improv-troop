# Copy to .env.local (gitignored) and fill in only what you need. Every key here is optional:
# without one, visitors bring their own in “Brains & sounds”, or the band plays from its sketchbook.
# Anyone who can reach this server spends the keys you set, so leave them unset on a public deployment.

# Vercel AI Gateway key (https://vercel.com/ai-gateway): every model in the pickers.
IMPROV_TROOP_SERVER_KEY=

# Anthropic API key (https://console.anthropic.com/settings/keys): Claude models only, called directly.
# Used when no gateway key applies; see “Keys” in README.md for the full precedence.
ANTHROPIC_API_KEY=
